                challengeDesc: "Asocia cada documento histórico bolivariano con su propósito político clave:",
                type: "match",
                pairs: [
                    { id: "p1", leader: "Carta de Jamaica (1815)", event: "Diagnóstico del futuro de América y llamado a la unión continental." },
                    { id: "p2", leader: "Congreso de Angostura (1819)", event: "Creación legal de la Gran Colombia (Venezuela, Colombia, Ecuador)." },
                    { id: "p3", leader: "Batalla de Boyacá (1819)", event: "Liberación de la Nueva Granada y toma del Virreinato de Santa Fe." }
                ],
                clue: "Pista #4 (1819): El proyecto bolivariano buscó la integración política de la Nueva Granada y Venezuela en la Gran Colombia.",
