            {
                id: 5,
                title: "5. El Sello Final",
                subtitle: "Perú y Ayacucho (1824) — Sucre y la Independencia Total",
                context: "A pesar de las independencias locales, el Virreinato del Perú continuaba siendo el bastión militar español más poderoso. La alianza entre los ejércitos del Norte (Bolívar) y del Sur culminó el 9 de diciembre de 1824 en la Pampa de la Quinua, donde el Mariscal Antonio José de Sucre dirigió la Batalla de Ayacucho, firmándose la Capitulación definitiva.",
                challengeDesc: "Responde al enigma conceptual para consolidar la soberanía del continente:",
                type: "quiz",
                question: "¿Qué consecuencia directa tuvo la Capitulación de Ayacucho en 1824?",
                answers: [
                    "La rendición definitiva del ejército realista y el fin formal de la dominación española en Sudamérica.",
                    "La reanexión inmediata de las colonias a la corona francesa.",
                    "El inicio de la firma de tratados de libre comercio obligatorios con Napoleón.",
                    "La disolución de los ejércitos patriotas y retorno al sistema virreinal."
                ],
                correctIndex: 0,
                clue: "Pista #5 (1824): Ayacucho constituyó el sello de la independencia continental y la consolidación de las repúblicas latinoamericanas.",
                medal: "Gran Sol de Ayacucho",
                medalDesc: "Alcanzaste el sello final de la emancipación de Latinoamérica."
            }
        ];

        class IndependenceApp {
            constructor() {
                this.completedStations = new Set();
                this.unlockedStations = new Set([1]);
                this.currentStationId = null;
                this.userOrderState = [];
                this.cipherOffset = 3;
            }

            init() {
                this.renderMapState();
                this.renderClues();
                this.renderLogros();
                lucide.createIcons();
            }

            renderMapState() {
                STATIONS_DATA.forEach(st => {
                    const node = document.getElementById(`map-node-${st.id}`);
                    const icon = document.getElementById(`node-icon-${st.id}`);
                    const badge = document.getElementById(`node-badge-${st.id}`);
                    const check = document.getElementById(`node-check-${st.id}`);

                    if (this.completedStations.has(st.id)) {
                        node.className = "cursor-pointer group flex flex-col items-center text-center p-4 rounded-xl transition-all duration-300 bg-green-100/90 border-2 border-green-700 hover:scale-105 shadow-md";
                        if (badge) {
                            badge.className = "mt-3 text-[10px] font-bold tracking-widest uppercase bg-green-800 text-green-100 px-2.5 py-0.5 rounded-full";
                            badge.textContent = "Liberado";
                        }
                        if (check) check.classList.remove('hidden');
                        if (icon) icon.setAttribute('data-lucide', 'check');
                    } else if (this.unlockedStations.has(st.id)) {
                        node.className = "cursor-pointer group flex flex-col items-center text-center p-4 rounded-xl transition-all duration-300 bg-amber-100/90 border-2 border-amber-700 hover:scale-105 active-station shadow-lg";
                        if (badge) {
                            badge.className = "mt-3 text-[10px] font-bold tracking-widest uppercase bg-amber-800 text-amber-100 px-2.5 py-0.5 rounded-full";
                            badge.textContent = "Disponible";
                        }
                        if (check) check.classList.add('hidden');
                        if (icon) icon.setAttribute('data-lucide', 'unlock');
                    } else {
                        node.className = "opacity-50 cursor-not-allowed group flex flex-col items-center text-center p-4 rounded-xl transition-all duration-300 bg-amber-100/40 border-2 border-amber-400";
                        if (badge) {
                            badge.className = "mt-3 text-[10px] font-bold tracking-widest uppercase bg-amber-800/40 text-amber-950 px-2.5 py-0.5 rounded-full";
                            badge.textContent = "Bloqueado";
                        }
                        if (check) check.classList.add('hidden');
                        if (icon) icon.setAttribute('data-lucide', 'lock');
                    }
                });

                const percent = Math.round((this.completedStations.size / 5) * 100);
                document.getElementById('progress-bar').style.width = `${percent}%`;
                document.getElementById('progress-text').textContent = `${percent}% Completado`;
                document.getElementById('medals-count').textContent = `${this.completedStations.size}/5 Medallas`;
                document.getElementById('clues-found-count').textContent = `${this.completedStations.size}`;

                lucide.createIcons();
            }

            openStation(id) {
                sound.playClick();
                if (!this.unlockedStations.has(id)) return;

                this.currentStationId = id;
                const station = STATIONS_DATA.find(s => s.id === id);

                document.getElementById('modal-station-number').textContent = station.id;
                document.getElementById('modal-station-title').textContent = station.title;
                document.getElementById('modal-station-subtitle').textContent = station.subtitle;
                document.getElementById('modal-station-context').textContent = station.context;
                document.getElementById('modal-challenge-desc').textContent = station.challengeDesc;

                const feedbackEl = document.getElementById('modal-feedback');
                feedbackEl.className = "hidden p-4 rounded-xl text-sm font-semibold flex items-start gap-3";
                feedbackEl.innerHTML = "";

                const container = document.getElementById('modal-enigma-container');
                container.innerHTML = "";

                if (station.type === 'caesar') {
                    this.renderCaesarChallenge(container, station);
                } else if (station.type === 'order') {
                    this.renderOrderChallenge(container, station);
                } else if (station.type === 'decision') {
                    this.renderDecisionChallenge(container, station);
                } else if (station.type === 'match') {
                    this.renderMatchChallenge(container, station);
                } else if (station.type === 'quiz') {
                    this.renderQuizChallenge(container, station);
                }

                document.getElementById('station-modal').classList.remove('hidden');
                lucide.createIcons();
            }

            closeStationModal() {
                sound.playClick();
                document.getElementById('station-modal').classList.add('hidden');
            }

            // Station Specific Renderers
            renderCaesarChallenge(container, station) {
                const box = document.createElement('div');
                box.className = "space-y-4 text-center";
                
                box.innerHTML = `
                    <div class="p-4 bg-amber-950 text-amber-200 rounded-xl font-mono text-base md:text-lg tracking-widest border border-patriotGold shadow-inner">
                        <span class="text-xs text-amber-400 block font-header mb-1">CÓDIGO CIFRADO ENCONTRADO EN CARACAS:</span>
                        "${station.cipherText}"
                    </div>

                    <div class="p-3 bg-amber-200/50 rounded-xl border border-amber-300">
                        <label class="block text-xs font-bold text-amber-950 mb-2">Selecciona la palabra descifrada que completa la proclama:</label>
                        <div class="grid grid-cols-2 gap-2">
                            ${station.options.map(opt => `
                                <button onclick="app.selectCaesarOption('${opt}')" id="caesar-btn-${opt}" class="caesar-opt-btn p-2.5 bg-white border border-amber-400 rounded-lg text-xs md:text-sm font-bold text-amber-950 hover:bg-amber-300 transition">
                                    ${opt}
                                </button>
                            `).join('')}
                        </div>
                    </div>
                `;
                container.appendChild(box);
                this.selectedCaesarOption = null;
            }

            selectCaesarOption(word) {
                sound.playClick();
                this.selectedCaesarOption = word;
                document.querySelectorAll('.caesar-opt-btn').forEach(btn => {
                    btn.classList.remove('bg-patriotGold', 'text-amber-950', 'ring-2', 'ring-amber-800');
                    btn.classList.add('bg-white');
                });
                const selectedBtn = document.getElementById(`caesar-btn-${word}`);
                if (selectedBtn) {
                    selectedBtn.classList.remove('bg-white');
                    selectedBtn.classList.add('bg-patriotGold', 'text-amber-950', 'ring-2', 'ring-amber-800');
                }
            }

            renderOrderChallenge(container, station) {
                this.userOrderState = [...station.items].sort(() => Math.random() - 0.5);
                const list = document.createElement('div');
                list.className = "space-y-2";
                list.id = "sortable-list";
                container.appendChild(list);
                this.renderOrderItems(list);
            }

            renderOrderItems(container) {
                container.innerHTML = "";
                this.userOrderState.forEach((item, index) => {
                    const div = document.createElement('div');
                    div.className = "flex items-center justify-between p-3 bg-white/80 rounded-xl border border-amber-300 shadow-sm gap-3";
                    div.innerHTML = `
                        <div class="flex items-center gap-3">
                            <span class="w-6 h-6 rounded-full bg-amber-900 text-amber-100 text-xs font-bold flex items-center justify-center flex-shrink-0">${index + 1}</span>
                            <span class="text-xs md:text-sm text-amber-950">${item.label}</span>
                        </div>
                        <div class="flex flex-col gap-1">
                            <button onclick="app.moveOrderItem(${index}, -1)" class="p-1 hover:bg-amber-200 rounded text-amber-900 ${index === 0 ? 'opacity-30 pointer-events-none' : ''}">
                                <i data-lucide="chevron-up" class="w-4 h-4"></i>
                            </button>
                            <button onclick="app.moveOrderItem(${index}, 1)" class="p-1 hover:bg-amber-200 rounded text-amber-900 ${index === this.userOrderState.length - 1 ? 'opacity-30 pointer-events-none' : ''}">
                                <i data-lucide="chevron-down" class="w-4 h-4"></i>
                            </button>
                        </div>
                    `;
                    container.appendChild(div);
                });
                lucide.createIcons();
            }

            moveOrderItem(index, direction) {
                sound.playClick();
                const target = index + direction;
                if (target < 0 || target >= this.userOrderState.length) return;
                const temp = this.userOrderState[index];
                this.userOrderState[index] = this.userOrderState[target];
                this.userOrderState[target] = temp;
                this.renderOrderItems(document.getElementById('sortable-list'));
            }

            renderDecisionChallenge(container, station) {
                const box = document.createElement('div');
                box.className = "space-y-3";
                station.options.forEach((opt, idx) => {
                    box.innerHTML += `
                        <label class="flex items-start gap-3 p-3.5 bg-white/80 rounded-xl border border-amber-300 cursor-pointer hover:bg-amber-50 transition">
                            <input type="radio" name="st3-decision" value="${idx}" class="mt-1 accent-amber-800 w-4 h-4">
                            <span class="text-xs md:text-sm text-amber-950 leading-relaxed">${opt.text}</span>
                        </label>
                    `;
                });
                container.appendChild(box);
            }

            renderMatchChallenge(container, station) {
                const box = document.createElement('div');
                box.className = "space-y-3";
                station.pairs.forEach((pair, idx) => {
                    const events = station.pairs.map(p => p.event).sort();
                    let opts = `<option value="">-- Seleccionar Propósito Histórico --</option>`;
                    events.forEach(e => {
                        opts += `<option value="${e}">${e}</option>`;
                    });

                    box.innerHTML += `
                        <div class="p-3 bg-white/80 border border-amber-300 rounded-xl flex flex-col md:flex-row items-start md:items-center justify-between gap-3">
                            <span class="font-header font-bold text-xs md:text-sm text-amber-950 min-w-[180px]">${pair.leader}:</span>
                            <select id="match-select-${idx}" class="w-full md:w-auto flex-1 p-2 bg-amber-50 border border-amber-400 rounded-lg text-xs text-amber-950 font-medium">
                                ${opts}
                            </select>
                        </div>
                    `;
                });
                container.appendChild(box);
            }

            renderQuizChallenge(container, station) {
                const box = document.createElement('div');
                box.className = "space-y-3";
                box.innerHTML = `<p class="text-xs md:text-sm font-bold text-amber-950 mb-2">${station.question}</p>`;
                station.answers.forEach((ans, idx) => {
                    box.innerHTML += `
                        <label class="flex items-center gap-3 p-3 bg-white/80 rounded-xl border border-amber-300 cursor-pointer hover:bg-amber-50 transition">
                            <input type="radio" name="st5-radio" value="${idx}" class="accent-amber-800 w-4 h-4">
                            <span class="text-xs md:text-sm text-amber-950">${ans}</span>
                        </label>
                    `;
                });
                container.appendChild(box);
            }

            // Main Verification Engine
            verifyCurrentStation() {
                const station = STATIONS_DATA.find(s => s.id === this.currentStationId);
                let isCorrect = false;
                let feedbackText = "";

                if (station.type === 'caesar') {
                    if (this.selectedCaesarOption === station.targetWord) {
                        isCorrect = true;
                        feedbackText = "¡Descifrado exitoso! Al aplicar el desplazamiento, la palabra clave resultante es SOBERANÍA, pilar fundamental de las Juntas de 1808.";
                    } else {
                        isCorrect = false;
                        feedbackText = "Palabra incorrecta. Revisa el desplazamiento de letras en el alfabeto para encontrar la palabra adecuada.";
                    }

                } else if (station.type === 'order') {
                    const currentIds = this.userOrderState.map(i => i.id);
                    isCorrect = JSON.stringify(currentIds) === JSON.stringify(station.correctOrder);
                    feedbackText = isCorrect 
                        ? "¡Secuencia histórica exacta! Desde el Grito de Dolores (1810) hasta el Plan de Iguala (1821)." 
                        : "Orden incorrecto. Recuerda que el Grito de Dolores ocurrió primero en 1810, seguido por los Sentimientos de la Nación de Morelos.";

                } else if (station.type === 'decision') {
                    const selected = document.querySelector('input[name="st3-decision"]:checked');
                    if (selected) {
                        const optIdx = parseInt(selected.value);
                        const chosenOpt = station.options[optIdx];
                        isCorrect = chosenOpt.correct;
                        feedbackText = chosenOpt.explanation;
                    } else {
                        isCorrect = false;
                        feedbackText = "Por favor selecciona una estrategia antes de verificar.";
                    }

                } else if (station.type === 'match') {
                    let allMatched = true;
                    station.pairs.forEach((pair, idx) => {
                        const val = document.getElementById(`match-select-${idx}`).value;
                        if (val !== pair.event) allMatched = false;
                    });
                    isCorrect = allMatched;
                    feedbackText = isCorrect 
                        ? "¡Asociación perfecta! Has conectado correctamente las cartas y discursos de Simón Bolívar con sus hitos." 
                        : "Revisa las selecciones. Recuerda que la Carta de Jamaica (1815) trataba el futuro de América y Boyacá la toma de la Nueva Granada.";

                } else if (station.type === 'quiz') {
                    const selected = document.querySelector('input[name="st5-radio"]:checked');
                    if (selected && parseInt(selected.value) === station.correctIndex) {
                        isCorrect = true;
                        feedbackText = "¡Correcto! La capitulación de Ayacucho provocó el retiro formal de las tropas españolas del continente sudamericano.";
                    } else {
                        isCorrect = false;
                        feedbackText = "Respuesta incorrecta. Recuerda el impacto definitivo de la victoria militar del Mariscal Sucre en Ayacucho.";
                    }
                }

                this.showFeedback(isCorrect, feedbackText);

                if (isCorrect) {
                    sound.playSuccess();
                    this.completedStations.add(this.currentStationId);
                    
                    if (this.currentStationId < 5) {
                        this.unlockedStations.add(this.currentStationId + 1);
                    }

                    this.renderMapState();
                    this.renderClues();
                    this.renderLogros();

                    if (this.completedStations.size === 5) {
                        setTimeout(() => {
                            this.closeStationModal();
                            sound.playVictoryFanfare();
                            this.showVictoryModal();
                        }, 1800);
                    }
                } else {
                    sound.playError();
                }
            }

            showFeedback(isCorrect, text) {
                const fb = document.getElementById('modal-feedback');
                fb.classList.remove('hidden', 'bg-green-900/20', 'border-green-600', 'text-green-950', 'bg-red-900/20', 'border-red-600', 'text-red-950');
                
                if (isCorrect) {
                    fb.classList.add('bg-green-900/20', 'border', 'border-green-600', 'text-green-950');
                    fb.innerHTML = `
                        <i data-lucide="check-circle" class="w-5 h-5 text-green-700 flex-shrink-0 mt-0.5"></i>
                        <div>
                            <span class="font-bold block mb-0.5">¡Pista Desbloqueada!</span>
                            <p>${text}</p>
                        </div>
                    `;
                } else {
                    fb.classList.add('bg-red-900/20', 'border', 'border-red-600', 'text-red-950');
                    fb.innerHTML = `
                        <i data-lucide="alert-triangle" class="w-5 h-5 text-red-700 flex-shrink-0 mt-0.5"></i>
                        <div>
                            <span class="font-bold block mb-0.5">Enigma No Resuelto</span>
                            <p>${text}</p>
                        </div>
                    `;
                }
                lucide.createIcons();
            }

            renderClues() {
                const container = document.getElementById('clues-container');
                container.innerHTML = "";

                if (this.completedStations.size === 0) {
                    container.innerHTML = `
                        <div class="col-span-full bg-amber-950/5 border border-dashed border-amber-800/30 p-4 rounded-xl flex items-center justify-center text-xs text-amber-800/60 italic text-center min-h-[80px]">
                            Supera la Estación 1 para registrar tu primera pista histórica en el diario de expedición...
                        </div>
                    `;
                    return;
                }

                STATIONS_DATA.forEach(st => {
                    if (this.completedStations.has(st.id)) {
                        const card = document.createElement('div');
                        card.className = "bg-amber-100/90 border border-amber-400 p-4 rounded-xl shadow-sm space-y-2 relative overflow-hidden";
                        card.innerHTML = `
                            <div class="flex items-center justify-between border-b border-amber-300 pb-1.5">
                                <span class="font-header font-bold text-xs text-patriotRed uppercase tracking-wider">Hallazgo Histórico #${st.id}</span>
                                <i data-lucide="bookmark" class="w-4 h-4 text-patriotGold"></i>
                            </div>
                            <p class="text-xs text-amber-950 leading-relaxed font-semibold">${st.clue}</p>
                        `;
                        container.appendChild(card);
                    }
                });
                lucide.createIcons();
            }

            renderLogros() {
                const list = document.getElementById('logros-list');
                list.innerHTML = "";

                STATIONS_DATA.forEach(st => {
                    const isUnlocked = this.completedStations.has(st.id);
                    const div = document.createElement('div');
                    div.className = `p-3.5 rounded-xl border flex items-center gap-3 transition ${
                        isUnlocked 
                        ? 'bg-amber-100 border-patriotGold text-amber-950 shadow' 
                        : 'bg-amber-950/10 border-amber-900/20 text-amber-900/50 opacity-60'
                    }`;
                    div.innerHTML = `
                        <div class="w-10 h-10 rounded-full ${isUnlocked ? 'bg-patriotGold text-amber-950' : 'bg-amber-800/30 text-amber-900'} flex items-center justify-center font-bold flex-shrink-0">
                            <i data-lucide="${isUnlocked ? 'award' : 'lock'}" class="w-5 h-5"></i>
                        </div>
                        <div>
                            <h4 class="font-header font-bold text-xs ${isUnlocked ? 'text-amber-950' : 'text-amber-900/70'}">${st.medal}</h4>
                            <p class="text-[11px]">${isUnlocked ? st.medalDesc : 'Supera la estación para ganar esta condecoración.'}</p>
                        </div>
                    `;
                    list.appendChild(div);
                });
                lucide.createIcons();
            }

            toggleLogrosModal() {
                sound.playClick();
                document.getElementById('logros-modal').classList.toggle('hidden');
            }

            showVictoryModal() {
                document.getElementById('victory-modal').classList.remove('hidden');
                lucide.createIcons();
            }
        }

        let app;
        window.addEventListener('DOMContentLoaded', () => {
            app = new IndependenceApp();
            app.init();
        });
    </script>
</body>
</html>
